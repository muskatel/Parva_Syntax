- comment: Single line comments
  name: comment.pvm
  match: ;.*

- comment: Keywords
  name: markup.pvm
  match: ((\d+[ \t]*))((\b)(LDC(_(M1|[0-9]))?|LDA(_[0-9])?|LDL(_[0-9])?|STL(_[0-9])?|ISLET|ALEN|ANEW|CALL|FHDR|HALT|LDGA|LDXA|PRNB|PRNC|PRNI|PRNL|PRNS|RETV|TRAP|INPB|INPC|INPI|ADD|AND|BEQ|BGE|BGT|BLE|BLT|BNE|BNZ|BRN|BZE|CEQ|CGE|CGT|CLE|CLT|CNE|DEC|DIV|DSP|DUP|INC|LDE|LDG|LDV|LOW|MUL|NEG|NOP|NOT|POP|REM|RET|SEL|STE|STG|STO|SUB|SWI|JR|OR)(\b))
  captures:
    '3': {name: keyword.pvm}
    
- comment: String Quotes
  name: string.pvm
  match: (\")(.*)(\")

- comment: String Quotes
  name: string.pvm
  match: (\')(.*)(\')

- comment: Numbers
  name: constant.numeric.pvm
  match: (-?\d+)

