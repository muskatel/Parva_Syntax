<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>fileTypes</key>
	<array>
		<string>pvm</string>
	</array>
	<key>name</key>
	<string>Parva PVM</string>
	<key>patterns</key>
	<array>
		<dict>
			<key>comment</key>
			<string>Single line comments</string>
			<key>match</key>
			<string>;.*</string>
			<key>name</key>
			<string>comment.pvm</string>
		</dict>
		<dict>
			<key>captures</key>
			<dict>
				<key>3</key>
				<dict>
					<key>name</key>
					<string>keyword.pvm</string>
				</dict>
			</dict>
			<key>comment</key>
			<string>Keywords</string>
			<key>match</key>
			<string>((\d+[ \t]*))((\b)(LDC(_(M1|[0-9]))?|LDA(_[0-9])?|LDL(_[0-9])?|STL(_[0-9])?|ISLET|ALEN|ANEW|CALL|FHDR|HALT|LDGA|LDXA|PRNB|PRNC|PRNI|PRNL|PRNS|RETV|TRAP|INPB|INPC|INPI|ADD|AND|BEQ|BGE|BGT|BLE|BLT|BNE|BNZ|BRN|BZE|CEQ|CGE|CGT|CLE|CLT|CNE|DEC|DIV|DSP|DUP|INC|LDE|LDG|LDV|LOW|MUL|NEG|NOP|NOT|POP|REM|RET|SEL|STE|STG|STO|SUB|SWI|JR|OR)(\b))</string>
			<key>name</key>
			<string>markup.pvm</string>
		</dict>
		<dict>
			<key>comment</key>
			<string>String Quotes</string>
			<key>match</key>
			<string>(\")(.*)(\")</string>
			<key>name</key>
			<string>string.pvm</string>
		</dict>
		<dict>
			<key>comment</key>
			<string>String Quotes</string>
			<key>match</key>
			<string>(\')(.*)(\')</string>
			<key>name</key>
			<string>string.pvm</string>
		</dict>
		<dict>
			<key>comment</key>
			<string>Numbers</string>
			<key>match</key>
			<string>(-?\d+)</string>
			<key>name</key>
			<string>constant.numeric.pvm</string>
		</dict>
	</array>
	<key>scopeName</key>
	<string>source.pvm</string>
	<key>uuid</key>
	<string>db0162e4-19a4-4453-8d3c-d59e08e0dd70</string>
</dict>
</plist>
