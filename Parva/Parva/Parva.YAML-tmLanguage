name: Parva
scopeName: source.pav
fileTypes: [pav]
uuid: 4aa6b831-8d6c-4b2c-96f3-7a46d049f870

patterns:
- comment: In-line comments
  name: comment.pav
  begin: (\/\*)
  end: (\*\/)

- comment: Single line comments
  name: comment.pav
  match: \/\/.*

- comment: Numbers
  name: constant.numeric.pav
  match: (\d+)?(\.)?(\d+)

- comment: Boolean and null constants
  name: constant.language.pav
  match: (\b)(true|false|null)(\b)

- comment: Keywords
  name: keyword.pav
  match: (\b)(if|while|const|return|halt|new)(\b)

- comment: Words Parva reserves for later extensions
  name: keyword.pav
  match: (\b)(break|case|char|continue|default|do|else|for|goto|switch)(\b)

- comment: Support functions
  name: support.function.pav
  match: (\b)(read|write)(\b)

- comment: Storage types with Functions
  name: markup.pav
  match: (\b)(int|bool|void)(\b)( \w*)(\W*\()
  captures:
    '2':  {name: storage.type.pav}
    '4':  {name: entity.name.function.pav}

- comment: Storage types
  name: markup.pav
  match: (\b)(int|bool|void)(\b)
  captures:
    '2':  {name: storage.type.pav}
       
- comment: Function calls
  name: markup.pav
  match: (\b)(\w*)([ ]*\()
  captures:
    '2':  {name: support.function.pav}

- comment: String Quotes
  name: string.pav
  begin: (\")
  end: (\")

- comment: Char Quotes
  name: string.pav
  match: (\')(\\?.)(\')


